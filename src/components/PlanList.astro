---
import { Check } from "lucide-astro";

interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="mt-5 flex flex-col gap-2.5">
  {items.map((item) => (
    <li class="flex items-start gap-2 text-[14.5px]">
      <Check class="mt-1 size-4 shrink-0 text-brand-accent" aria-hidden="true" />
      {item}
    </li>
  ))}
</ul>
